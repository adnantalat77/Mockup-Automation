# Local server configuration.
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3001
# Production-only API origin when the frontend and API are hosted separately.
# Local Vite development uses its same-origin /api proxy instead.
VITE_API_URL=
MAX_UPLOAD_MB=12
# Release 1 launcher requires an explicit persistent data directory.
DATA_DIR=./data
# WEB_DIST_DIR is set to the verified production build by the launcher.

# Optional Phase 2 read-only Shopify integration. Keep secrets server-side.
# Client credentials work only for an installed Dev Dashboard app and a store
# in the same Shopify organization. Grant only read_products.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# Phase 4 remains off until a separately approved live test.
# Enabling also requires read_products, write_products, and write_files.
SHOPIFY_PUBLISHING_ENABLED=false
# These may remain empty for read-only startup. When publishing is true, use a
# random authorization value of at least 32 characters and an exact allowlist.
SHOPIFY_PUBLISHING_AUTH_TOKEN=
# Comma-separated Shopify Product GIDs approved for controlled real-product tests.
# Leave empty by default. The disposable draft test product remains separately eligible.
SHOPIFY_PUBLISH_PRODUCT_IDS=
